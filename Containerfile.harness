FROM ubuntu:24.04

LABEL org.opencontainers.image.source="https://github.com/ets-log736/log736-images"
LABEL org.opencontainers.image.description="LOG736 public laboratory harness"
LABEL org.opencontainers.image.title="LOG736 Harness"

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/log736

COPY harness/ /opt/log736/

USER 65532:65532

CMD ["python3", "--version"]
